export ::gl::GLenum operator+(::gl::GLenum a, unsigned b) {
    return ::gl::GLenum(unsigned(a) + b);
}

export ::gl::ClearBufferMask operator|(::gl::ClearBufferMask a, ::gl::ClearBufferMask b) {
    return ::gl::ClearBufferMask(std::to_underlying(a) | std::to_underlying(b));
}
